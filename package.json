{
  "name": "bluesky-profile-slurper",
  "version": "0.1.0",
  "description": "Archive an atproto account's public activity",
  "scripts": {
    "slurp": "node --env-file-if-exists=.env src/cli.ts",
    "typecheck": "tsc --noEmit",
    "serve": "node --env-file-if-exists=.env src/server.ts"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@atcute/repo": "^1.1.0"
  },
  "bin": {
    "slurp": "src/cli.ts"
  },
  "engines": {
    "node": ">=23.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
