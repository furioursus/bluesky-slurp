---
import EmptyState from '../../../components/ui/EmptyState.astro';
import Base from '../../../layouts/Base.astro';
import { listAccounts } from '../../../lib/archives.ts';

const { handle } = Astro.params;
if ((await listAccounts()).some((a) => a.handle === handle)) return Astro.redirect(`/a/${handle}/report`);
Astro.response.status = 404;
---

<Base title="Not archived" nav="accounts">
  <EmptyState title="Not archived"><a class="btn solid" href="/">Archive it</a></EmptyState>
</Base>
