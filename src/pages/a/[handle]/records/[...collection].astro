---
import CollectionList from '../../../../components/records/CollectionList.astro';
import Pager from '../../../../components/records/Pager.astro';
import RecordCard from '../../../../components/records/RecordCard.astro';
import RootsToggle from '../../../../components/records/RootsToggle.astro';
import Cell from '../../../../components/ui/Cell.astro';
import Grid from '../../../../components/ui/Grid.astro';
import AccountLayout from '../../../../layouts/AccountLayout.astro';
import { getHandles, getPosts } from '../../../../lib/appview.ts';
import { loadArchive, readRecords, type DeletedFilter } from '../../../../lib/archives.ts';
import { fmt } from '../../../../lib/format.ts';
import { localBlobFiles } from '../../../../lib/media.ts';
import { didOf, embedTargets, ROOTS_COOKIE } from '../../../../lib/ui.ts';

const PAGE = 50;
const POSTS = 'app.bsky.feed.post';

const { handle = '', collection: requested } = Astro.params;
const archive = await loadArchive(handle);
const live: Record<string, number> = archive?.manifest.counts ?? {};
const gone: Record<string, number> = archive?.manifest.deleted ?? {};
const counts: Record<string, number> = { ...live };
for (const [c, n] of Object.entries(gone)) counts[c] = (counts[c] ?? 0) + n;
const collection = requested ?? (POSTS in counts ? POSTS : Object.keys(counts)[0]);
const unknown = !!archive && !!collection && !(collection in counts);
if (unknown) Astro.response.status = 404;
const offset = Math.max(0, Number(Astro.url.searchParams.get('offset')) || 0);
const order = Astro.url.searchParams.get('order') === 'oldest' ? 'oldest' : 'newest';
const showRoots = Astro.cookies.get(ROOTS_COOKIE)?.value === '1';
const filter: DeletedFilter = Astro.url.searchParams.get('show') === 'deleted' && collection && gone[collection] ? 'deleted' : 'all';
const base = `/a/${handle}/records`;

const page = archive && collection && !unknown ? await readRecords(archive.dir, collection, offset, PAGE, order, filter) : null;
const records = page?.records ?? [];
const pointers = records.flatMap((rec) => rec.refs.filter((x) => x.kind !== 'blob'));
const [posts, handles, localFiles] = await Promise.all([
  getPosts(records.flatMap((rec) => embedTargets(rec.refs.filter((x) => x.kind !== 'blob'), showRoots).map((x) => x.target))),
  getHandles(pointers.filter((x) => x.kind === 'record' || x.kind === 'account').map((x) => didOf(x.target))),
  archive ? localBlobFiles(archive.dir) : Promise.resolve(new Set<string>()),
]);
const href = (o: number, ord: 'newest' | 'oldest' = order, show: DeletedFilter = filter) => `${base}/${collection}?offset=${o}&order=${ord}${show === 'deleted' ? '&show=deleted' : ''}`;
---

<AccountLayout archive={archive} tab="records">
  <Grid cols="side">
    <Cell flush><CollectionList counts={counts} current={collection} base={base} /></Cell>
    <Cell flush>
      <Cell stack="sm" divided>
        <h2 class="subtitle break case-normal">{collection ?? 'No records'}</h2>
        {unknown && <p class="notice">This archive has no {collection} collection. Pick one from the list.</p>}
        {collection && gone[collection] > 0 && (
          <p class="filter" data-keep-scroll>
            <a href={href(0, order, 'all')} aria-current={filter === 'all' ? 'page' : undefined}>All · {fmt(counts[collection])}</a>
            <a href={href(0, order, 'deleted')} aria-current={filter === 'deleted' ? 'page' : undefined}>Deleted · {fmt(gone[collection])}</a>
          </p>
        )}
        {collection === POSTS && <RootsToggle checked={showRoots} />}
        {page && <Pager href={href} offset={offset} limit={PAGE} total={page.total} order={order} />}
      </Cell>
      {records.map((rec) => <RecordCard handle={handle} rec={rec} posts={posts} handles={handles} showRoots={showRoots} localFiles={localFiles} accountHandle={archive?.manifest.handle ?? null} />)}
      {page && records.length > 5 && <Cell><Pager href={href} offset={offset} limit={PAGE} total={page.total} order={order} /></Cell>}
    </Cell>
  </Grid>
</AccountLayout>

<style>
  .filter { display: flex; gap: var(--space-md); font-size: var(--text-sm); text-transform: uppercase; letter-spacing: var(--track); }
  .filter a { text-decoration: none; }
  .filter a[aria-current='page'] { text-decoration: underline; text-underline-offset: var(--space-2xs); }
</style>
