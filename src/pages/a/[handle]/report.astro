---
import AnalysisActions from '../../../components/jobs/AnalysisActions.astro';
import NoReport from '../../../components/jobs/NoReport.astro';
import UpgradeReport from '../../../components/jobs/UpgradeReport.astro';
import HeadlineStats from '../../../components/report/HeadlineStats.astro';
import InterestsSection from '../../../components/report/InterestsSection.astro';
import ShapeSection from '../../../components/report/ShapeSection.astro';
import TargetingSection from '../../../components/report/TargetingSection.astro';
import Cell from '../../../components/ui/Cell.astro';
import Grid from '../../../components/ui/Grid.astro';
import Tabs from '../../../components/ui/Tabs.astro';
import AccountLayout from '../../../layouts/AccountLayout.astro';
import type { WindowKey } from '../../../lib/analyze.ts';
import { loadArchive } from '../../../lib/archives.ts';
import { WINDOW_TABS } from '../../../lib/ui.ts';

const { handle = '' } = Astro.params;
const archive = await loadArchive(handle);
const r = archive?.analysis ?? null;
const requested = Astro.url.searchParams.get('w');
const key = (r?.windows?.includes(requested as WindowKey) ? requested : 'all') as WindowKey;
const W = r?.byWindow?.[key];
const base = `/a/${handle}/report`;
---

<AccountLayout archive={archive} tab="report">
  {
    !r ? (
      <NoReport handle={handle} />
    ) : !r.byWindow || !W ? (
      <UpgradeReport handle={handle} />
    ) : (
      <>
        <Tabs label="Time window" keepScroll items={r.windows.map((k) => ({ href: `${base}?w=${k}`, label: WINDOW_TABS[k] ?? k, current: k === key }))} />
        <HeadlineStats report={r} windowKey={key} />
        <Grid>
          <Cell>
            <p><strong>Signals, not a verdict. </strong>A high and rising cold share, bursts at one person, and quotes of strangers are the classic bad-faith patterns. Open the linked posts before you conclude anything. Lots of blocks usually means block lists, not aggression.</p>
            {W.shape.posts === 0 && <p class="notice mt-sm">No posts in the {W.label.toLowerCase()} before the last update.</p>}
          </Cell>
        </Grid>
        <ShapeSection report={r} windowKey={key} />
        <TargetingSection window={W} />
        <AnalysisActions handle={handle} />
        <InterestsSection window={W} apps={r.appsUsed} />
      </>
    )
  }
</AccountLayout>
