---
import AccountGrid from '../components/account/AccountGrid.astro';
import ArchiveForm from '../components/jobs/ArchiveForm.astro';
import Section from '../components/ui/Section.astro';
import Base from '../layouts/Base.astro';
import { listAccounts } from '../lib/archives.ts';

const RECENT = 6;
const accounts = await listAccounts();
---

<Base nav="home">
  <ArchiveForm />
  {accounts.length > 0 && <Section title="On disk"><AccountGrid accounts={accounts.slice(0, RECENT)} /></Section>}
</Base>
