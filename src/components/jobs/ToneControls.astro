---
import { DEFAULT_MODEL } from '../../lib/tone.ts';
import { hasApiKey } from '../../lib/archives.ts';
import { MODELS } from '../../lib/ui.ts';
import Check from '../ui/Check.astro';

interface Props {
  withToggle?: boolean;
}

const { withToggle = true } = Astro.props;
const keyPresent = hasApiKey();
---

<div class="stack">
  {withToggle && <Check name="tone" title="Tone pass" note="Claude labels replies and quotes. Shows a cost estimate and asks before spending." />}
  <div class="split">
    <label class="field">
      <span class="kicker">Model</span>
      <select class="input small" name="model" aria-label="Tone model">
        {MODELS.map((m) => <option value={m} selected={m === DEFAULT_MODEL}>{m}</option>)}
      </select>
    </label>
    <label class="field">
      <span class="kicker">Posts to label</span>
      <input class="input small" name="toneLimit" type="number" min="1" max="2000" value="200" aria-label="Posts to label" />
    </label>
  </div>
  {!keyPresent && <p class="notice">No ANTHROPIC_API_KEY in the server environment. Put it in .env and restart, or the tone pass will fail.</p>}
</div>
