---
interface Props {
  mode: 'archive' | 'analyze' | 'media';
  input?: string;
  snapshot?: string;
  after: 'open' | 'reload';
}

const { mode, input, snapshot, after } = Astro.props;
---

<job-runner data-mode={mode} data-input={input} data-snapshot={snapshot} data-after={after}>
  <slot />
  <div data-panel-slot></div>
  <template>
    <section class="grid job">
      <div class="cell stack">
        <div class="status-line">
          <h3 class="subtitle" data-title></h3>
          <span class="kicker" data-status>starting</span>
        </div>
        <pre class="log" aria-live="polite" data-log></pre>
      </div>
      <div class="cell span-all" data-finish hidden>
        <a class="btn solid" data-open hidden></a>
      </div>
    </section>
  </template>
</job-runner>

<script>
  import { navigate } from 'astro:transitions/client';
  import { keepScrollOnNextSwap } from '../../lib/scroll.ts';

  type JobEvent = { type: 'log' | 'done' | 'error'; data: any };

  const AUTO_RELOAD_MS = 600;
  const TITLES: Record<string, string> = { archive: 'Archiving', analyze: 'Analyzing', media: 'Downloading media for' };

  const refresh = () => {
    keepScrollOnNextSwap();
    navigate(location.pathname + location.search, { history: 'replace' });
  };

  class JobRunner extends HTMLElement {
    events?: EventSource;

    connectedCallback() {
      this.querySelector('form')?.addEventListener('submit', (e) => this.start(e as SubmitEvent));
    }

    disconnectedCallback() {
      this.events?.close();
    }

    async start(e: SubmitEvent) {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const fd = new FormData(form);
      const { mode, input, snapshot, after } = this.dataset;
      const request = {
        mode,
        input: input ?? String(fd.get('input') ?? ''),
        snapshot,
        media: fd.has('media'),
        analyze: fd.has('analyze'),
      };
      for (const b of form.querySelectorAll('button')) b.disabled = true;

      const panel = (this.querySelector('template')!.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
      const $ = <T extends HTMLElement>(sel: string) => panel.querySelector<T>(sel)!;
      $('[data-title]').textContent = `${TITLES[mode ?? 'analyze'] ?? 'Running'} ${request.input}`;
      this.querySelector('[data-panel-slot]')!.replaceChildren(panel);
      panel.scrollIntoView({ behavior: 'smooth', block: 'start' });

      const status = (text: string) => ($('[data-status]').textContent = text);
      const log = $('[data-log]');
      const append = (line: string) => {
        const span = document.createElement('span');
        if (/⚠|error/.test(line)) span.className = 'warn';
        span.textContent = `${line}\n`;
        log.append(span);
        log.scrollTop = log.scrollHeight;
      };
      const finish = () => {
        for (const b of form.querySelectorAll('button')) b.disabled = false;
      };

      const res = await fetch('/api/jobs', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(request) });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) {
        append(`error: ${body.error ?? res.status}`);
        status('failed');
        return finish();
      }
      status('running');

      const events = (this.events = new EventSource(`/api/jobs/${body.id}/events`));
      events.onmessage = (msg) => {
        const ev: JobEvent = JSON.parse(msg.data);
        if (ev.type === 'log') append(ev.data);
        if (ev.type === 'error') {
          append(`error: ${ev.data}`);
          status('failed');
          events.close();
          finish();
        }
        if (ev.type === 'done') {
          status('done');
          events.close();
          finish();
          $('[data-finish]').hidden = false;
          if (after === 'open') {
            const open = $<HTMLAnchorElement>('[data-open]');
            open.href = `/a/${ev.data.handle}/${ev.data.snapshot}/report`;
            open.textContent = `Open ${ev.data.handle}`;
            open.hidden = false;
          } else {
            status('done, reloading');
            setTimeout(refresh, AUTO_RELOAD_MS);
          }
        }
      };
    }
  }

  customElements.define('job-runner', JobRunner);
</script>

<style>
  job-runner { display: block; }
  .status-line { display: flex; justify-content: space-between; gap: var(--space-md); align-items: baseline; }
  .log {
    font-family: var(--mono);
    font-size: var(--text-xs);
    line-height: var(--leading);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    max-height: var(--scroll-box);
    overflow: auto;
    margin: 0;
  }
  .log :global(.warn) { font-weight: 700; }
</style>
