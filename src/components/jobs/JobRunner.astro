---
import type { JobMode } from '../../lib/jobs.ts';

interface Props {
  mode: JobMode;
  input?: string;
  after: 'open' | 'reload';
  attach?: string | null;
}

const { mode, input, after, attach } = Astro.props;
---

<job-runner data-mode={mode} data-input={input} data-after={after} data-attach={attach ?? undefined}>
  <slot />
  <div data-panel-slot></div>
  <template>
    <section class="grid job">
      <div class="cell stack">
        <div class="status-line">
          <h3 class="subtitle" data-title></h3>
          <span class="kicker" data-status>starting</span>
        </div>
        <pre class="log" aria-live="polite" data-log></pre>
      </div>
      <div class="cell span-all" data-finish hidden>
        <a class="btn solid" data-open hidden></a>
      </div>
    </section>
  </template>
</job-runner>

<script>
  import { navigate } from 'astro:transitions/client';
  import { keepScrollOnNextSwap } from '../../lib/scroll.ts';

  type JobEvent = { type: 'log' | 'done' | 'error'; data: any };

  const AUTO_RELOAD_MS = 600;
  const TITLES: Record<string, string> = { archive: 'Archiving', analyze: 'Analyzing', media: 'Downloading media for', 'update-all': 'Updating every account' };

  const refresh = () => {
    keepScrollOnNextSwap();
    navigate(location.pathname + location.search, { history: 'replace' });
  };

  class JobRunner extends HTMLElement {
    events?: EventSource;

    connectedCallback() {
      this.querySelector('form')?.addEventListener('submit', (e) => this.start(e as SubmitEvent));
      if (this.dataset.attach) this.follow(this.dataset.attach, this.heading(this.dataset.input ?? ''));
    }

    heading(input: string) {
      const { mode } = this.dataset;
      return mode === 'update-all' ? TITLES[mode] : `${TITLES[mode ?? 'analyze'] ?? 'Running'} ${input}`;
    }

    panel(title: string) {
      const panel = (this.querySelector('template')!.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
      const $ = <T extends HTMLElement>(sel: string) => panel.querySelector<T>(sel)!;
      $('[data-title]').textContent = title;
      this.querySelector('[data-panel-slot]')!.replaceChildren(panel);
      const log = $('[data-log]');
      return {
        $,
        status: (text: string) => ($('[data-status]').textContent = text),
        append: (line: string) => {
          const span = document.createElement('span');
          if (/⚠|error/.test(line)) span.className = 'warn';
          span.textContent = `${line}\n`;
          log.append(span);
          log.scrollTop = log.scrollHeight;
        },
      };
    }

    buttons(disabled: boolean) {
      for (const b of this.querySelectorAll('button')) b.disabled = disabled;
    }

    follow(id: string, title: string, ui = this.panel(title)) {
      const { after } = this.dataset;
      ui.status('running');
      this.buttons(true);
      const events = (this.events = new EventSource(`/api/jobs/${id}/events`));
      events.onmessage = (msg) => {
        const ev: JobEvent = JSON.parse(msg.data);
        if (ev.type === 'log') ui.append(ev.data);
        if (ev.type === 'error') {
          ui.append(`error: ${ev.data}`);
          ui.status('failed');
          events.close();
          this.buttons(false);
        }
        if (ev.type === 'done') {
          ui.status('done');
          events.close();
          this.buttons(false);
          ui.$('[data-finish]').hidden = false;
          if (after === 'open' && ev.data?.handle) {
            const open = ui.$<HTMLAnchorElement>('[data-open]');
            open.href = `/a/${ev.data.handle}/report`;
            open.textContent = `Open ${ev.data.handle}`;
            open.hidden = false;
          } else {
            ui.status('done, reloading');
            setTimeout(refresh, AUTO_RELOAD_MS);
          }
        }
      };
    }

    disconnectedCallback() {
      this.events?.close();
    }

    async start(e: SubmitEvent) {
      e.preventDefault();
      const fd = new FormData(e.target as HTMLFormElement);
      const { mode, input } = this.dataset;
      const request = { mode, input: input ?? String(fd.get('input') ?? ''), media: fd.has('media'), analyze: fd.has('analyze') };
      this.buttons(true);
      const ui = this.panel(this.heading(request.input));
      this.querySelector('[data-panel-slot]')!.scrollIntoView({ behavior: 'smooth', block: 'start' });

      const res = await fetch('/api/jobs', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(request) });
      const body = await res.json().catch(() => ({}));
      if (res.status === 409 && body.id) {
        ui.append(body.error);
        return this.follow(body.id, this.heading(request.input), ui);
      }
      if (!res.ok) {
        ui.append(`error: ${body.error ?? res.status}`);
        ui.status('failed');
        return this.buttons(false);
      }
      this.follow(body.id, this.heading(request.input), ui);
    }
  }

  customElements.define('job-runner', JobRunner);
</script>

<style>
  job-runner { display: block; }
  .status-line { display: flex; justify-content: space-between; gap: var(--space-md); align-items: baseline; }
  .log {
    font-family: var(--mono);
    font-size: var(--text-xs);
    line-height: var(--leading);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    max-height: var(--scroll-box);
    overflow: auto;
    margin: 0;
  }
  .log :global(.warn) { font-weight: 700; }
</style>
