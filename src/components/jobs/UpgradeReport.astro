---
import EmptyState from '../ui/EmptyState.astro';
import JobRunner from './JobRunner.astro';

interface Props {
  handle: string;
}

const { handle } = Astro.props;
---

<JobRunner mode="analyze" input={handle} after="reload">
  <form>
    <EmptyState size="title" title="This report predates time windows" body="Re-run the analysis to drill into 30 days, 3 months, 6 months and 1 year. It’s free and takes about a second.">
      <button class="btn solid" type="submit">Re-run analysis</button>
    </EmptyState>
  </form>
</JobRunner>
