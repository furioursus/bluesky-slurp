---
import Cell from '../ui/Cell.astro';
import Grid from '../ui/Grid.astro';
import JobRunner from './JobRunner.astro';

interface Props {
  handle: string;
}

const { handle } = Astro.props;
---

<JobRunner mode="analyze" input={handle} after="reload">
  <form>
    <Grid cols="side">
      <Cell stack="sm">
        <h2 class="subtitle">Re-run</h2>
        <p class="muted">Recomputes every window from the archive as it stands. Free, offline, about a second.</p>
      </Cell>
      <Cell><div class="btn-row"><button class="btn solid" type="submit">Re-run analysis</button></div></Cell>
    </Grid>
  </form>
</JobRunner>
