---
import type { WindowReport } from '../../lib/analyze.ts';
import Stat from '../ui/Stat.astro';

interface Props {
  tone: WindowReport['tone'];
  hasTonePass: boolean;
  sampleLimited: boolean;
}

const { tone, hasTonePass, sampleLimited } = Astro.props;
const cold = tone?.cold;
const warm = tone?.warm;

const value = cold?.total ? `${cold.pctBadFaith}%` : '—';
const note = !tone
  ? hasTonePass ? 'no labelled posts in this window' : 'no tone pass yet'
  : !cold!.total
    ? `no cold posts sampled${warm!.total ? `; ${warm!.pctBadFaith}% of ${warm!.total} warm` : ''}`
    : warm!.total
      ? `vs ${warm!.pctBadFaith}% toward people they know · ${cold!.total} cold / ${warm!.total} warm`
      : `of ${cold!.total} cold posts · no warm posts sampled, so no baseline`;
---

<Stat kicker="Bad faith, cold" value={value} note={note}>
  {tone && sampleLimited && <p class="muted text-xs">sample-limited, see Tone below</p>}
</Stat>
