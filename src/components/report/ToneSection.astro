---
import type { Report, WindowReport } from '../../lib/analyze.ts';
import { toneSentence } from '../../lib/analyze.ts';
import { fmt, shortDate } from '../../lib/format.ts';
import { LABELS } from '../../lib/tone.ts';
import { BAD_FAITH } from '../../lib/ui.ts';
import Cell from '../ui/Cell.astro';
import Ext from '../ui/Ext.astro';
import Grid from '../ui/Grid.astro';
import Section from '../ui/Section.astro';

interface Props {
  window: WindowReport;
  coverage: Report['toneCoverage'];
  sampleLimited: boolean;
}

const { window: W, coverage, sampleLimited } = Astro.props;
const t = W.tone!;
const width = (n: number, total: number) => `width:${total ? (n / total) * 100 : 0}%`;
const covers = coverage ? ` The full sample covers ${shortDate(coverage.from)} – ${shortDate(coverage.to)}.` : '';
---

<Section title="Tone" sub={`${W.label}: ${fmt(t.labelled)} labelled posts, by ${t.model}${t.refused ? `, ${t.refused} without a label` : ''}.${covers} Each label is a model’s reading of one post in context.`}>
  <Grid>
    <Cell>
      <p class="subtitle case-normal">{toneSentence(t)}</p>
      <p class="muted mt-xs">A big gap between the two is the tell. A high number on both is just how they talk.</p>
      {
        sampleLimited && coverage && (
          <p class="notice mt-sm">
            Tone labels only cover {shortDate(coverage.from)} – {shortDate(coverage.to)}, so this window’s tone numbers are the sample’s. Run a bigger tone pass to reach further back.
          </p>
        )
      }
    </Cell>
    <Cell>
      <table class="data">
        <thead>
          <tr><th>Label</th><th class="num">Cold ({t.cold.total})</th><th></th><th class="num">Warm ({t.warm.total})</th><th></th></tr>
        </thead>
        <tbody>
          {
            LABELS.map((l) => (
              <tr>
                <td>{l}{BAD_FAITH.has(l) && <span class="tag solid">bad faith</span>}</td>
                <td class="num">{t.cold.counts[l]}</td>
                <td class="wide"><div class="bar"><i style={width(t.cold.counts[l], t.cold.total)} /></div></td>
                <td class="num">{t.warm.counts[l]}</td>
                <td class="wide"><div class="bar hatch"><i style={width(t.warm.counts[l], t.warm.total)} /></div></td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </Cell>
    <Cell stack="lg">
      {
        LABELS.filter((l) => t.examples[l]?.length).map((l) => (
          <div class="stack">
            <h3 class="subtitle">{l}</h3>
            <ol class="ranked">
              {t.examples[l].map((e) => (
                <li>
                  <span class="who"><Ext href={e.web}>post ↗</Ext> {e.reason}</span>
                  <span class="count muted">{e.confidence}{e.cold ? ' · cold' : ''}</span>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </Cell>
  </Grid>
</Section>

<style>
  .bar { height: var(--bar); background: var(--faint); position: relative; }
  .bar > i { position: absolute; inset: 0 auto 0 0; background: var(--ink); }
  .bar.hatch > i { background: repeating-linear-gradient(45deg, var(--ink) 0 calc(var(--line) * 2), transparent 0 calc(var(--line) * 5)); }
</style>
