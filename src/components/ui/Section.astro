---
import Cell from './Cell.astro';
import Grid from './Grid.astro';

interface Props {
  title: string;
  sub?: string | null;
}

const { title, sub } = Astro.props;
---

<Grid cols="side">
  <Cell stack="sm">
    <h2 class="title">{title}</h2>
    {sub && <p class="muted">{sub}</p>}
    <slot name="aside" />
  </Cell>
  <Cell flush><slot /></Cell>
</Grid>
