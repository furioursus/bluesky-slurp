---
import Grid from './Grid.astro';

interface Props {
  label: string;
  items: { href: string; label: string; current: boolean }[];
  keepScroll?: boolean;
}

const { label, items, keepScroll = false } = Astro.props;
---

<Grid>
  <nav class="cell tabs" aria-label={label} data-keep-scroll={keepScroll || undefined}>
    {items.map((item) => <a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>)}
  </nav>
</Grid>

<style>
  .tabs { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: var(--line); background: var(--ink); padding: 0; }
  a { background: var(--paper); display: grid; place-items: center; min-height: var(--control); padding: var(--space-xs); text-align: center; text-decoration: none; text-transform: uppercase; letter-spacing: var(--track); }
  a:hover, a[aria-current='page'] { background: var(--ink); color: var(--paper); }
</style>
