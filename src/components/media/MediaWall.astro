---
import type { MediaItem } from '../../lib/media.ts';
import { isSensitive } from '../../lib/media-view.ts';
import { SENSITIVE } from '../../lib/ui.ts';
import SensitiveReveal from '../ui/SensitiveReveal.astro';

interface Props {
  handle: string;
  items: MediaItem[];
  href: (item: MediaItem) => string;
}

const { handle, items, href } = Astro.props;
const thumb = (i: MediaItem) => `/thumbs/${handle}/${i.file}`;
---

<div class="wall">
  <div class="tiles">
    {
      items.map((i) => (
        <a class:list={['tile', { blurred: isSensitive(i, SENSITIVE) }]} href={href(i)} title={[i.at?.slice(0, 10), i.uses[0]?.alt].filter(Boolean).join(' · ')}>
          {i.kind !== 'other' && <img src={thumb(i)} alt={i.uses.find((u) => u.alt)?.alt ?? ''} loading="lazy" decoding="async" />}
          {i.kind === 'other' && <span class="mime">{i.mimeType ?? 'file'}</span>}
          {i.kind === 'video' && <b class="badge">▶</b>}
        </a>
      ))
    }
  </div>
</div>

<SensitiveReveal />

<script>
  import { blurOn } from '../../lib/blur.ts';

  document.addEventListener('click', (e) => {
    const tile = (e.target as HTMLElement).closest('.tile');
    if (tile && !(tile.classList.contains('blurred') && blurOn())) sessionStorage.setItem('slurp-media-wall', location.pathname + location.search);
  });
</script>

<style>
  .wall { overflow: hidden; border-bottom: var(--line) solid var(--ink); }
  .tiles {
    --tile: 10rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--tile), 1fr));
    margin-right: calc(-1 * var(--line));
    margin-bottom: calc(-1 * var(--line));
  }
  .tile {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-right: var(--line) solid var(--ink);
    border-bottom: var(--line) solid var(--ink);
    background: var(--faint);
    overflow: hidden;
    text-decoration: none;
  }
  .tile img { width: 100%; height: 100%; object-fit: cover; min-width: 0; }
  :global(:root:not([data-blur='off'])) .tile.blurred img { filter: blur(var(--blur)) grayscale(1); }
  .badge { position: absolute; left: var(--space-xs); bottom: var(--space-xs); background: var(--ink); color: var(--paper); padding: var(--space-3xs) var(--space-xs); font-weight: 400; font-size: var(--text-xs); }
  .mime { font-family: var(--mono); font-size: var(--text-xs); color: var(--muted); padding: var(--space-sm); overflow-wrap: anywhere; text-align: center; }
</style>
