---
import { FONT_STACKS } from '../lib/fonts.ts';
---

<div class="font-picker" transition:persist="font-picker">
  <button class="corner-toggle font-toggle" type="button" popovertarget="font-menu" aria-label="Choose font">
    <span class="label">font</span>
    <span class="sample" aria-hidden="true">Aa</span>
  </button>
  <div id="font-menu" class="font-menu" popover>
    <fieldset>
      <legend>
        <span class="kicker">Font</span>
        <small>System fonts from Modern Font Stacks. Each shows whatever this device has installed.</small>
      </legend>
      {
        FONT_STACKS.map((f) => (
          <label class="font-option">
            <input type="radio" name="slurp-font" value={f.key} />
            <span style={`font-family: ${f.stack}`}>{f.label}</span>
          </label>
        ))
      }
    </fieldset>
  </div>
</div>

<script>
  import { applyFont, FONT_KEY } from '../lib/fonts.ts';

  const root = document.documentElement;
  const menu = document.getElementById('font-menu')!;
  const radios = () => menu.querySelectorAll<HTMLInputElement>('input[type=radio]');
  const sync = () => radios().forEach((r) => (r.checked = r.value === root.dataset.font));

  menu.addEventListener('change', (e) => {
    const key = (e.target as HTMLInputElement).value;
    applyFont(key);
    try { localStorage.setItem(FONT_KEY, key); } catch {}
  });
  menu.addEventListener('toggle', (e) => {
    if ((e as ToggleEvent).newState !== 'open') return;
    sync();
    menu.querySelector<HTMLInputElement>('input:checked')?.focus();
  });
  document.addEventListener('astro:before-swap', (e) => {
    const next = e.newDocument.documentElement;
    if (root.dataset.font) next.dataset.font = root.dataset.font;
    for (const prop of ['--font', '--wordmark-glyphs']) next.style.setProperty(prop, root.style.getPropertyValue(prop));
  });
  sync();
</script>

<style>
  .font-toggle { left: calc(var(--toggle-w) * 2); }
  .sample { display: grid; place-content: center; width: var(--box); height: var(--box); border: var(--line) solid var(--ink); font-size: var(--text-2xs); line-height: 1; }

  /* see docs/web-ui.md#fonts */
  .font-menu {
    position: fixed;
    inset: auto auto var(--toggle-h) 0;
    margin: 0;
    padding: 0;
    width: var(--menu-w);
    max-width: 100vw;
    max-height: calc(100dvh - var(--toggle-h) - var(--space-lg));
    overflow-y: auto;
    background: var(--paper);
    color: var(--ink);
    border: var(--line) solid var(--ink);
    border-left: 0;
    border-bottom: 0;
  }
  fieldset { margin: 0; padding: 0; border: 0; min-width: 0; }
  legend { display: grid; gap: var(--space-2xs); padding: var(--space-sm) var(--pad); float: left; width: 100%; }
  legend small { color: var(--muted); font-size: var(--text-xs); }
  .font-option { clear: both; display: flex; align-items: center; gap: var(--space-sm); padding: var(--space-xs) var(--pad); border-top: var(--line) solid var(--ink); cursor: pointer; font-size: var(--text-lg); }
  .font-option:hover, .font-option:has(input:checked) { background: var(--ink); color: var(--paper); }
  input { appearance: none; flex: none; width: var(--box); height: var(--box); margin: 0; border: var(--line) solid currentColor; display: grid; place-content: center; cursor: pointer; }
  input::after { content: ''; width: var(--box-mark); height: var(--box-mark); background: currentColor; transform: scale(0); }
  input:checked::after { transform: scale(1); }
</style>
