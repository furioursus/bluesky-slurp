---
import { blobFileName } from '../../lib/archive.ts';
import type { Ref } from '../../lib/refs.ts';
import Ext from '../ui/Ext.astro';

interface Props {
  handle: string;
  media: Ref[];
  images: any[] | undefined;
  localFiles: Set<string>;
}

const { handle, media, images, localFiles } = Astro.props;
const local = (x: Ref) => localFiles.has(blobFileName(x.target, x.mimeType));
const src = (x: Ref) => (local(x) ? `/blobs/${handle}/${blobFileName(x.target, x.mimeType)}` : x.web);
const alt = (x: Ref) => images?.find((i) => i.image?.ref?.$link === x.target)?.alt || '';
---

<div class="thumbs">
  {
    media.map((x) =>
      x.mimeType?.startsWith('video/') ? (
        local(x) ? <video src={src(x)} controls preload="metadata" /> : <Ext href={x.web}><span class="chip">video ↗</span></Ext>
      ) : x.mimeType?.startsWith('image/') ? (
        <Ext href={src(x)}><img src={src(x)} alt={alt(x)} loading="lazy" /></Ext>
      ) : (
        <Ext href={x.web}><span class="chip">{x.mimeType ?? 'blob'} ↗</span></Ext>
      ),
    )
  }
</div>
