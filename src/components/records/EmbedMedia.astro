---
import type { PostView } from '../../lib/appview.ts';
import { bskyPostUrl } from '../../lib/ui.ts';
import Ext from '../ui/Ext.astro';
import SensitiveReveal from '../ui/SensitiveReveal.astro';

interface Props {
  embed: PostView['embed'];
  sensitive: boolean;
}

const { embed: e, sensitive } = Astro.props;
const type: string = e?.$type ?? '';
const kind = type.split('.').at(-1)?.replace('#view', '');
const quoted = kind === 'record' ? e.record : kind === 'recordWithMedia' ? e.record?.record : null;
const media = kind === 'recordWithMedia' ? e.media : kind === 'images' || kind === 'video' || kind === 'external' ? e : null;
const mediaKind = media?.$type?.split('.').at(-1)?.replace('#view', '');
---

{
  mediaKind === 'images' && (
    <div class="thumbs">
      {media.images.map((img: any) => (
        <Ext href={img.fullsize} class={sensitive ? 'blurred' : undefined}>
          <img src={img.thumb} alt={img.alt || ''} loading="lazy" />
        </Ext>
      ))}
    </div>
  )
}
{
  mediaKind === 'video' &&
    (media.thumbnail ? (
      <div class="thumbs">
        <span class:list={['video-thumb', { blurred: sensitive }]}>
          <img src={media.thumbnail} alt={media.alt || ''} loading="lazy" />
          <b>▶ video</b>
        </span>
      </div>
    ) : (
      <p class="muted">▶ video</p>
    ))
}
{
  mediaKind === 'external' && (
    <Ext href={media.external.uri} class="link-card-link">
      <div class="link-card">
        {media.external.thumb && <img src={media.external.thumb} alt="" loading="lazy" />}
        <div>
          <strong>{media.external.title || media.external.uri}</strong>
          {media.external.description && <p class="muted">{media.external.description}</p>}
          <p class="mono muted break">{media.external.uri.replace(/^https?:\/\//, '').split('/')[0]}</p>
        </div>
      </div>
    </Ext>
  )
}
{
  quoted &&
    (quoted.author ? (
      <div class="quote">
        <p>
          <span class="kicker">Quoting </span>
          <Ext href={quoted.uri?.includes('/app.bsky.feed.post/') ? bskyPostUrl(quoted.uri) : `https://bsky.app/profile/${quoted.author.did}`}>@{quoted.author.handle}</Ext>
        </p>
        {quoted.value?.text && <p class="text">{quoted.value.text}</p>}
      </div>
    ) : (
      <div class="quote muted">Quoted post unavailable</div>
    ))
}

<style>
  .quote { border-left: var(--line-bold) solid var(--ink); padding: var(--space-2xs) 0 var(--space-2xs) var(--space-sm); margin-top: var(--space-sm); font-size: var(--text-sm); }
  .text { margin-top: var(--space-xs); white-space: pre-wrap; overflow-wrap: anywhere; }
  :global(a.link-card-link) { text-decoration: none; display: block; }
  .link-card { display: grid; grid-template-columns: var(--thumb-min) minmax(0, 1fr); gap: var(--space-sm); border: var(--line) solid var(--ink); margin-top: var(--space-sm); padding: var(--space-sm); font-size: var(--text-sm); }
  .link-card img { width: var(--thumb-min); aspect-ratio: 4 / 3; object-fit: cover; filter: grayscale(1); }
  .video-thumb { position: relative; display: inline-block; }
  .video-thumb b { position: absolute; left: var(--space-xs); bottom: var(--space-xs); background: var(--ink); color: var(--paper); padding: var(--space-3xs) var(--space-xs); font-weight: 400; font-size: var(--text-xs); }
</style>

<SensitiveReveal />
