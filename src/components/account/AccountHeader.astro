---
import type { Archive } from '../../lib/archives.ts';
import { fmt } from '../../lib/format.ts';
import Cell from '../ui/Cell.astro';
import Ext from '../ui/Ext.astro';
import Grid from '../ui/Grid.astro';

interface Props {
  archive: Archive;
}

const { archive } = Astro.props;
const { manifest: m, profile: p } = archive;
---

<Grid class="account-head">
  <Cell flush>{p?.avatar ? <img class="avatar lg" src={p.avatar} alt="" /> : <div class="avatar lg" />}</Cell>
  <Cell stack="sm">
    <p class="kicker">{m.handleVerified ? 'Verified handle' : '⚠ Handle does not verify'}</p>
    <h1 class="title break case-normal">@{m.handle ?? m.did}</h1>
    {p?.displayName && <p class="subtitle case-normal">{p.displayName}</p>}
    {p?.description && <p class="muted break prewrap">{p.description}</p>}
    <p class="mono muted break">{m.did}</p>
    {m.noUnauthenticated && <p class="notice solid">This account asks apps not to show its posts to logged-out viewers.</p>}
  </Cell>
  <Cell stack="sm">
    <div>
      <p class="kicker">Records</p>
      <p class="big-number">{fmt(m.totalRecords)}</p>
    </div>
    {m.deletedRecords > 0 && <p>+ {fmt(m.deletedRecords)} deleted, kept</p>}
    {p && <p>{fmt(p.followersCount)} followers · {fmt(p.followsCount)} following</p>}
    <div class="btn-row">
      <Ext href={m.profileUrl}>Bluesky ↗</Ext>
      <Ext href={`https://pdsls.dev/at://${m.did}`}>Repo ↗</Ext>
    </div>
  </Cell>
</Grid>

<style>
  .account-head { grid-template-columns: minmax(0, 0.9fr) minmax(0, 2fr) minmax(0, 1.3fr); }
  @media (--narrow) {
    .account-head { grid-template-columns: minmax(0, 1fr); }
    .avatar.lg { width: calc(var(--avatar) * 2); }
  }
</style>
